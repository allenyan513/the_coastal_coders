{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tidecount",
      "runtimeExecutable": "tidecount/server/.venv/bin/python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "tidecount.api:app",
        "--app-dir",
        "tidecount/server",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "tidecount-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "tidecount/web",
        "dev"
      ],
      "port": 5183
    }
  ]
}
