{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tidecount",
      "runtimeExecutable": "tidecount/server/.venv/bin/python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "tidecount.app:app",
        "--app-dir",
        "tidecount/server",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "tidecount-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "tidecount/web",
        "dev"
      ],
      "port": 5183
    },
    {
      "name": "prototype",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8020",
        "-d",
        "tidecount/prototype"
      ],
      "port": 8020
    }
  ]
}
